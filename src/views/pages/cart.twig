{#
| Variable      | Type       | Description                                              |
|---------------|------------|------------------------------------------------------------|
| cart          | Cart       | See Salla's Twilight docs for the full Cart reference       |
| cart.items[]  | CartItem[] |                                                             |

Aura-styled adaptation of Raed's cart.twig — keeps the real cart loop,
item fields and Twilight cart components; gifting/loyalty widgets from
the base theme are left out of this starter (add back from theme-raed
if needed).
#}
{% extends "layouts.master" %}
{% block content %}
    <div class="container">
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        <h1 class="aura-cart-title">{{ trans('blocks.header.cart') }}</h1>
        <salla-conditional-offer data-testid="store-cart-conditional-offer"></salla-conditional-offer>

        <div class="aura-cart-layout">
            <div class="aura-cart-items">
                {% hook 'cart:items.start' %}

                {% for item in cart.items %}
                    <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
                        <section data-testid="store-cart-item-{{ item.id }}" class="aura-cart-item">
                            <input type="hidden" name="id" value="{{ item.id }}">

                            <a href="{{ item.url }}" class="aura-cart-item__image">
                                <img src="{{ item.product_image }}" alt="{{ item.product_name }}"
                                     loading="{{ loop.first ? 'eager' : 'lazy' }}" class="w-full h-full object-cover">
                            </a>

                            <div class="aura-cart-item__info">
                                <h3><a href="{{ item.url }}">{{ item.product_name }}</a></h3>
                                <span class="aura-cart-item__price {{ item.has_discount ? 'is-sale' : '' }}">{{ item.price|money }}</span>
                                {% if item.offer %}<span class="aura-cart-item__offer">{{ item.offer.names }}</span>{% endif %}
                                <a class="aura-cart-item__remove"
                                   onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                                    <i class="sicon-cancel"></i> إزالة
                                </a>
                            </div>

                            <div class="aura-cart-item__qty">
                                {% if item.type == 'donating' %}
                                    <span></span>
                                {% elseif item.is_hidden_quantity %}
                                    <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity"/>
                                    <span>{{ item.quantity }}</span>
                                {% else %}
                                    <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}"
                                                           aria-label="Quantity" value="{{ item.quantity }}" name="quantity">
                                    </salla-quantity-input>
                                {% endif %}
                            </div>

                            <div class="aura-cart-item__total">
                                <span class="aura-muted">{{ trans('pages.cart.total') }}</span>
                                <span data-testid="store-cart-item-total">
                                    {{ item.is_available ? (item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money) : trans('pages.cart.out_of_stock') }}
                                </span>
                            </div>

                            {% include 'pages.partials.product.options' with {product:item} %}
                        </section>
                    </form>
                {% else %}
                    <div data-testid="store-cart-empty" class="aura-cart-empty">
                        <i class="sicon-shopping-bag"></i>
                        <p>{{ trans('pages.cart.empty_cart') }}</p>
                        <a data-testid="store-cart-back-home" href="{{ link('/') }}" class="btn-aura-outline">{{ trans('common.elements.back_home') }}</a>
                    </div>
                {% endfor %}

                {% if cart.options|length %}
                    <div class="aura-cart-options">
                        {% for product_option in cart.options %}
                            <form class="relative" onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ product_option.id }}">
                                <input type="hidden" name="id" value="{{ product_option.id }}">
                                <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
                                {% include 'pages.partials.product.options' with { product: product_option } %}
                            </form>
                        {% endfor %}
                    </div>
                {% endif %}

                <salla-offer data-testid="store-cart-offer"></salla-offer>
                {% hook 'cart:items.end' %}

                {% if cart.items|length %}
                    <a href="{{ link('/') }}" class="aura-continue-shopping">
                        <i class="sicon-keyboard_arrow_right"></i> متابعة التسوق
                    </a>
                {% endif %}
            </div>

            {% hook 'cart:summary.start' %}

            {% if cart.items|length %}
                <aside class="aura-cart-summary">
                    <div class="aura-cart-summary__card {{ cart.free_shipping_bar ? '' : 'hidden' }}" id="free-shipping">
                        {% set is_free = cart.free_shipping_bar.has_free_shipping %}
                        <div class="aura-free-shipping">
                            <i class="sicon-shipping-fast"></i>
                            <div>
                                <h4>{{ trans('pages.cart.free_shipping') }}</h4>
                                <p id="free-shipping-msg">
                                    {{ (is_free ? trans('pages.cart.has_free_shipping') : trans('pages.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money})) | raw }}
                                </p>
                            </div>
                        </div>
                        <div class="aura-free-shipping__bar {{ is_free ? 'hidden' : '' }}" id="free-shipping-bar">
                            <div style="width:{{ cart.free_shipping_bar.percent }}%"></div>
                        </div>
                    </div>

                    {% if store.settings.cart.apply_coupon_enabled %}
                        <div class="aura-cart-summary__card">
                            {% hook 'cart:coupon.start' %}
                            <salla-cart-coupons data-testid="store-cart-coupons"></salla-cart-coupons>
                            {% hook 'cart:coupon.end' %}
                        </div>
                    {% endif %}

                    {% hook 'cart:summary-card.start' %}
                    <salla-cart-summary-card data-testid="store-cart-summary" class="aura-cart-summary__card"></salla-cart-summary-card>
                    {% hook 'cart:summary-card.end' %}
                    {% hook 'cart:summary.end' %}

                    <div class="aura-secure-note"><i class="sicon-shield-check"></i> دفع آمن ومشفر بالكامل</div>
                </aside>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
