{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header data-testid="store-header" class="aura-header">

    {# Utility / top bar #}
    <div class="aura-topbar">
        <div class="container flex items-center justify-between">
            <div class="flex items-center gap-5">
                {% if important_links %}
                    <salla-menu data-testid="store-header-topnav" source="footer" topnav></salla-menu>
                {% endif %}
            </div>
            <div class="flex items-center gap-5">
                {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                    <salla-localization-modal data-testid="store-header-localization" show-trigger></salla-localization-modal>
                {% endif %}
                <salla-contacts data-testid="store-header-contacts" is-header></salla-contacts>
            </div>
        </div>
    </div>

    {# Main nav — logo centered, categories on one side, actions on the other,
       matching the Aura mockup's balanced three-column header. #}
    <div id="mainnav" class="aura-mainnav">
        <div class="container">
            <div class="flex items-center justify-between relative py-4">

                <div class="flex items-center gap-8">
                    <a data-testid="store-header-mobile-toggle" class="lg:hidden mburger mburger--collapse leading-none" href="#mobile-menu" aria-label="Open menu">
                        <i class="sicon-menu text-2xl"></i>
                    </a>
                    <custom-main-menu class="hidden lg:block"></custom-main-menu>
                </div>

                <a data-testid="store-header-logo" class="aura-logo" href="{{ store.url }}">
                    <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
                    {% if is_page('index') %}
                        <h1 class="sr-only">{{ store.name }}</h1>
                    {% else %}
                        <h2 class="sr-only">{{ store.name }}</h2>
                    {% endif %}
                </a>

                <div class="flex items-center gap-1">
                    <salla-search data-testid="store-header-search" class="aura-icon-btn"></salla-search>
                    <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger class="aura-icon-btn"></salla-user-menu>
                    <salla-cart-summary data-testid="store-header-cart" class="aura-icon-btn aura-cart-summary">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
                    </salla-cart-summary>
                </div>
            </div>
        </div>
    </div>
</header>
