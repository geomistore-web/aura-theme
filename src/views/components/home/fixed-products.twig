{#
| Variable              | Type      | Description                                                      |
|-----------------------|-----------|---------------------------------------------------------------------|
| products.source       | string    |                                                                    |
| products.source_value | ?int[]    | ids of sources (product_ids, categories_ids, brands_id..etc)      |
| title                 | string    | Section title                                                     |
| display_all_url       | ?string   | If present, show a "view all" link to this url                   |
| position              | Int       | Sorting number start from zero                                    |
| limit                 | int       | Number of products to be shown                                    |
#}
<section component-id="{{ componentId }}" data-testid="store-home-fixed-products" class="aura-products">
    <div class="container">
        {% if title %}
            <div class="aura-section-head">
                <h2 class="aura-section-title">{{ title }}</h2>
                {% if display_all_url %}
                    <a href="{{ display_all_url }}" class="aura-section-link">{{ trans('blocks.home.display_all') }} ←</a>
                {% endif %}
            </div>
        {% endif %}
        <salla-products-list
            data-testid="store-home-fixed-products-list"
            source="{{ products.source }}"
            limit="{{ limit }}"
            source-value="{{ products.source_value|json_encode }}"
            class="aura-products__list">
        </salla-products-list>
    </div>
</section>
