{#
| Variable      | Type   | Description                                                      |
|---------------|--------|--------------------------------------------------------------------|
| items[]       | array  | List of 3 features                                               |
| items[].icon  | string | SallaIcons css class `sicon-*`                                   |
| items[].title | string | Title of the feature                                              |
| items[].text  | string | Subtitle for the feature                                          |
| position      | Int    | Sorting number start from zero                                    |
#}
<section component-id="{{ componentId }}" data-testid="store-home-features" class="aura-features">
    <div class="container aura-features__grid">
        {% for item in items %}
            <div class="aura-features__item">
                <i class="{{ item.icon }}"></i>
                <div>
                    <h4>{{ item.title }}</h4>
                    <p>{{ item.text }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
